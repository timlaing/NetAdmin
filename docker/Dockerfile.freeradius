FROM alpine:3.24

LABEL org.opencontainers.image.authors="tim@laingcorp.co.uk"

# No TLS material is baked into this image: the package ships only the certs
# tooling (bootstrap, *.cnf, Makefile) and materialise happens at runtime into
# the /etc/raddb/certs volume (see docker/entrypoint-radius.sh).
RUN apk update --no-cache \
  && apk add --no-cache \
    bash \
    freeradius \
    freeradius-eap \
    freeradius-utils \
    openssl

COPY docker/entrypoint-radius.sh /usr/local/bin/entrypoint-radius.sh

EXPOSE 1812/udp 1813/udp

ENTRYPOINT ["entrypoint-radius.sh"]
