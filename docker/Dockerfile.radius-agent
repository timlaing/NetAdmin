FROM python:3.12.11-alpine3.22
RUN apk add --no-cache freeradius freeradius-utils openssl
WORKDIR /app
COPY pyproject.toml /app/
COPY netadmin /app/netadmin
RUN pip install --no-cache-dir --only-binary :all: .
EXPOSE 8082
CMD ["sh", "-c", "exec gunicorn --bind 0.0.0.0:8082 --workers 1 --certfile /pki/server.crt --keyfile /pki/server.key --ca-certs /pki/ca.crt --cert-reqs 2 'netadmin.agents.radius:create_radius_agent()'"]
