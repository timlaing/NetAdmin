FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends isc-dhcp-server python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml /app/
COPY netadmin /app/netadmin
RUN pip3 install --break-system-packages --no-cache-dir --only-binary :all: .
EXPOSE 8081
CMD ["sh", "-c", "exec gunicorn --bind 0.0.0.0:8081 --workers 1 --certfile /pki/server.crt --keyfile /pki/server.key --ca-certs /pki/ca.crt --cert-reqs 2 'netadmin.agents.dhcp:create_dhcp_agent()'"]
