FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip isc-dhcp-server \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml /app/
COPY netadmin /app/netadmin
RUN pip3 install --break-system-packages --no-cache-dir .
EXPOSE 8081
CMD ["gunicorn", "--bind", "0.0.0.0:8081", "--workers", "1", "netadmin.agents.dhcp:create_dhcp_agent()"]
