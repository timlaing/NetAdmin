NETADMIN_SECRET_KEY=replace-with-random-value
NETADMIN_AGENT_TOKEN=replace-with-a-different-random-value
NETADMIN_ROOT_PASSWORD_HASH=replace-with-argon2id-hash
NETADMIN_RADIUS_SECRET=replace-with-radius-client-secret
NETADMIN_DNS_TSIG_SECRET=replace-with-base64-tsig-secret
NETADMIN_DNS_CONFIG_PATH=/bind-config/named.conf
NETADMIN_RADIUS_ROLE_ATTRIBUTE=Filter-Id
NETADMIN_RADIUS_ADMIN_VALUE=netadmin-admin
NETADMIN_RADIUS_STANDARD_VALUE=netadmin-standard
NETADMIN_AGENT_CA=/pki/ca.crt
NETADMIN_AGENT_CERT=/pki/netadmin.crt
NETADMIN_AGENT_KEY=/pki/netadmin.key
# Optional: seed existing RADIUS TLS material instead of generating a new CA
# (base64 PEM, see README "Key material"). SERVER_PEM and CA_PEM go together.
#NETADMIN_RADIUS_TLS_SERVER_PEM=
#NETADMIN_RADIUS_TLS_CA_PEM=
#NETADMIN_RADIUS_TLS_CA_KEY=
#NETADMIN_RADIUS_TLS_CLIENT_PEM=
